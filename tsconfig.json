{
	"extends": "@tommy-mitchell/configs/ts",
	"include": ["src", "test", "test-d"],
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
	},
}
